rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAmount(value) {
      return value is int && value > 0 && value <= 999999999;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['currency', 'monthlyIncome', 'monthlyInvestment'])
        && (!('currency' in data) || data.currency in ['BRL', 'EUR', 'USD'])
        && (
          !('monthlyIncome' in data)
          || isAmount(data.monthlyIncome)
        )
        && (
          !('monthlyInvestment' in data)
          || (
            'monthlyIncome' in data
            && isAmount(data.monthlyInvestment)
            && data.monthlyInvestment <= data.monthlyIncome
          )
        );
    }

    function isValidExpense(data) {
      return data.keys().hasOnly(['amount', 'billingCycle', 'createdAt', 'isActive', 'name'])
        && data.keys().hasAll(['amount', 'billingCycle', 'createdAt', 'isActive', 'name'])
        && isAmount(data.amount)
        && data.billingCycle in ['weekly', 'monthly', 'yearly']
        && data.createdAt is timestamp
        && data.isActive is bool
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);

      match /expenses/{expenseId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidExpense(request.resource.data);
        allow update: if isOwner(uid)
          && isValidExpense(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
